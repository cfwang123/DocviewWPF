								<TextBlock x:Name="lboutlineempty" DockPanel.Dock="Top"
								           Text="当前文档无章节 · 可拖入文件夹或文件夹快捷方式(.lnk)打开工作区"
								           Margin="10,8" FontSize="12" Foreground="#888" Visibility="Collapsed"
								           TextWrapping="Wrap"/>
								<TreeView x:Name="treeOutline" BorderThickness="0" Background="#F3F3F3"
								          Padding="4,2" FontSize="12.5" AllowDrop="True"/>
							</DockPanel>
						</TabItem>
					</TabControl>
				</Border>
				<GridSplitter x:Name="spleft" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
				              Background="{DynamicResource BorderSoft}" ResizeBehavior="PreviousAndNext"/>

				<!-- 内容：主栏 + 可选右分屏 -->
				<Grid x:Name="pcontent" Grid.Column="2" AllowDrop="True" Background="Transparent">
					<Grid.ColumnDefinitions>
						<ColumnDefinition x:Name="colmain" Width="*"/>
						<ColumnDefinition x:Name="colsplit" Width="0"/>
						<ColumnDefinition x:Name="colsidepane" Width="0"/>
					</Grid.ColumnDefinitions>
					<Grid Grid.Column="0">
						<StackPanel x:Name="pempty" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.9"
						            AllowDrop="True" Background="Transparent">
							<TextBlock Text="DocviewWPF" FontSize="24" FontWeight="SemiBold"
							           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
							<TextBlock Text="超快启动 · 多标签文档阅读器" FontSize="13" Margin="0,6,0,0"
							           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
							<TextBlock Text="支持 PDF · DOCX · XLSX · CSV · 代码 · 图片 · MD" FontSize="12" Margin="0,12,0,0"
							           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
							<TextBlock Text="Ctrl+O 打开 · 打开文件夹 · 拖放文件" FontSize="11" Margin="0,16,0,0"
							           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
						</StackPanel>
						<TabControl x:Name="tabs" Visibility="Collapsed"
						            Background="Transparent"
						            BorderThickness="0"
						            Padding="0"
						            AllowDrop="True"
						            Style="{StaticResource TabContentOnly}"
						            SelectionChanged="ontabchanged"/>
					</Grid>
					<GridSplitter x:Name="spsplit" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
					              Background="{DynamicResource BorderSoft}" Visibility="Collapsed"
					              ResizeBehavior="PreviousAndNext"/>
					<!-- 右分屏：独立加载另一文件（不共享 View） -->
					<Border x:Name="psplit" Grid.Column="2" Visibility="Collapsed"
					        BorderBrush="{DynamicResource Accent}" BorderThickness="1,0,0,0"
					        Background="{DynamicResource BgApp}">
						<DockPanel>
							<Border DockPanel.Dock="Top" Height="26" Background="{DynamicResource BgToolbar}"
							        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="6,0">
								<DockPanel>
									<Button x:Name="bsplitclose" DockPanel.Dock="Right" Content="✕" Width="28" Height="22"
									        ToolTip="关闭分屏" Padding="0" Margin="4,0,0,0"/>
									<ComboBox x:Name="csplitfile" Height="22" VerticalAlignment="Center"
									          ToolTip="选择分屏显示的文件"/>
								</DockPanel>
							</Border>
							<Border x:Name="psplithost" Background="White"/>
						</DockPanel>
					</Border>
				</Grid>
			</Grid>
		</DockPanel>
	</Border>
</Window>
