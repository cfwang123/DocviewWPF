<Window x:Class="DocviewWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DocviewWPF"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgApp}"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        PreviewKeyDown="onpreviewkeydown"
        PreviewTextInput="onpreviewtextinput"
        StateChanged="onstatechanged"
        FontSize="12">
	<!-- CaptionHeight 与标题栏同高：空白区由系统负责拖动/双击最大化；交互控件需 IsHitTestVisibleInChrome -->
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="28"
		                    ResizeBorderThickness="8,6,8,6"
		                    GlassFrameThickness="0"
		                    CornerRadius="0"
		                    UseAeroCaptionButtons="False"/>
	</shell:WindowChrome.WindowChrome>

	<Border x:Name="proot" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Background="{DynamicResource BgApp}">
		<DockPanel>
			<!-- 第 1 行：标题栏 = 汉堡菜单 + Tabs + 窗口按钮（仿 Sumatra） -->
			<Border x:Name="ptitle" DockPanel.Dock="Top" Height="28"
			        Background="{DynamicResource BgTitle}"
			        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
			        MouseLeftButtonDown="ontitledrag">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- 三横菜单 -->
					<Menu x:Name="mnmain" Grid.Column="0" Background="Transparent" VerticalAlignment="Stretch"
					      Padding="0" Margin="0"
					      shell:WindowChrome.IsHitTestVisibleInChrome="True">
						<MenuItem x:Name="mnhamburger" Padding="8,0" VerticalAlignment="Stretch"
						          ToolTip="菜单">
							<MenuItem.Header>
								<TextBlock Text="☰" FontSize="14" FontWeight="Normal"
								           Foreground="{DynamicResource TextPrimary}"
								           VerticalAlignment="Center"/>
							</MenuItem.Header>
							<MenuItem x:Name="mnfile" Header="文件">
								<MenuItem x:Name="mnopen" Header="打开(_O)..." InputGestureText="Ctrl+O"/>
								<MenuItem x:Name="mnopenfolder" Header="打开文件夹(_F)..."/>
								<MenuItem x:Name="mnrecent" Header="最近文件(_R)"/>
								<Separator/>
								<MenuItem x:Name="mnprint" Header="打印(_P)..." InputGestureText="Ctrl+P"/>
								<MenuItem x:Name="mnexport" Header="导出">
									<MenuItem x:Name="mnexporthtml" Header="Markdown 导出 HTML..."/>
									<MenuItem x:Name="mnexportpdf" Header="Markdown 导出 PDF..."/>
									<MenuItem x:Name="mnsaveimage" Header="图片另存为..."/>
								</MenuItem>
								<Separator/>
								<MenuItem x:Name="mncopypath" Header="复制文件路径"/>
								<MenuItem x:Name="mnshowinexplorer" Header="在资源管理器中显示"/>
								<MenuItem x:Name="mnopenwithsystem" Header="用系统应用打开"/>
								<Separator/>
								<MenuItem x:Name="mnclose" Header="关闭(_C)" InputGestureText="Ctrl+W"/>
								<MenuItem x:Name="mncloseall" Header="关闭全部"/>
								<MenuItem x:Name="mnreopen" Header="重新打开关闭的标签" InputGestureText="Ctrl+Shift+T"/>
								<Separator/>
								<MenuItem x:Name="mnexit" Header="退出(_X)" InputGestureText="Alt+F4"/>
							</MenuItem>
							<MenuItem x:Name="mnview" Header="查看">
								<MenuItem x:Name="mnzoomin" Header="放大" InputGestureText="Ctrl++"/>
								<MenuItem x:Name="mnzoomout" Header="缩小" InputGestureText="Ctrl+-"/>
								<MenuItem x:Name="mnzoom100" Header="实际大小 100%" InputGestureText="Ctrl+1"/>
								<MenuItem x:Name="mnfitpage" Header="适合页面" InputGestureText="Ctrl+0"/>
								<MenuItem x:Name="mnfitwidth" Header="适合宽度" InputGestureText="Ctrl+2"/>
								<Separator/>
								<MenuItem x:Name="mnprev" Header="上一页" InputGestureText="PgUp"/>
								<MenuItem x:Name="mnnext" Header="下一页" InputGestureText="PgDn"/>
								<MenuItem x:Name="mngotopage" Header="跳到页..." InputGestureText="Ctrl+G"/>
								<Separator/>
								<MenuItem x:Name="mnside" Header="目录侧栏" InputGestureText="F4" IsCheckable="True" IsChecked="True"/>
								<MenuItem x:Name="mnbookmarks" Header="书签栏" InputGestureText="Ctrl+Shift+B" IsCheckable="True"/>
								<MenuItem x:Name="mnaddbookmark" Header="添加书签..." InputGestureText="Ctrl+D"/>
								<MenuItem x:Name="mnsplit" Header="左右分屏" InputGestureText="Ctrl+\" IsCheckable="True"/>
								<MenuItem x:Name="mnsplitclose" Header="关闭分屏"/>
							</MenuItem>
							<MenuItem x:Name="mntools" Header="工具">
								<MenuItem x:Name="mnpdfeditor" Header="PDF 专业编辑(_E)..."/>
								<MenuItem x:Name="mnsettings" Header="系统参数(_P)..." InputGestureText="Ctrl+,"/>
							</MenuItem>
							<MenuItem x:Name="mnhelp" Header="帮助">
								<MenuItem x:Name="mnlang" Header="语言"/>
								<MenuItem x:Name="mncheckupdate" Header="检查更新..."/>
								<MenuItem x:Name="mabout" Header="关于 DocviewWPF"/>
							</MenuItem>
						</MenuItem>
					</Menu>

					<!-- Tabs 条 + 最右「+」新建浏览器标签（仿 Edge） -->
					<Grid Grid.Column="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<!-- ScrollViewer 本身不进 chrome（空白可拖窗）；各 Tab 芯片单独 IsHitTestVisibleInChrome -->
						<ScrollViewer x:Name="svtabs" Grid.Column="0"
						              HorizontalScrollBarVisibility="Hidden"
						              VerticalScrollBarVisibility="Disabled"
						              VerticalAlignment="Stretch"
						              Background="Transparent">
							<StackPanel x:Name="ptabs" Orientation="Horizontal" VerticalAlignment="Stretch"
							            Background="Transparent"/>
						</ScrollViewer>
						<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
							<!-- 新建：浏览器 / 命令行 -->
							<Button x:Name="bnewtab"
							        Content="+" ToolTip="新建标签（浏览器 / 命令行）"
							        Width="32" Height="24" Margin="2,2,2,2"
							        FontSize="16" FontWeight="Light" Padding="0"
							        Cursor="Hand" VerticalAlignment="Center"
							        Background="Transparent" BorderThickness="0"
							        Foreground="{DynamicResource TextMuted}"
							        shell:WindowChrome.IsHitTestVisibleInChrome="True">
								<Button.Template>
									<ControlTemplate TargetType="Button">
										<Border x:Name="bd" Background="{TemplateBinding Background}"
										        CornerRadius="6" Padding="0">
											<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="bd" Property="Background" Value="{DynamicResource CapBtnHover}"/>
												<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Button.Template>
								<Button.ContextMenu>
									<ContextMenu>
										<MenuItem x:Name="mnnewbrowser" Header="浏览器标签"/>
										<MenuItem x:Name="mnnewconsole" Header="命令行标签"/>
									</ContextMenu>
								</Button.ContextMenu>
							</Button>
						</StackPanel>
					</Grid>

					<!-- 窗口按钮 -->
					<StackPanel Grid.Column="2" Orientation="Horizontal"
					            shell:WindowChrome.IsHitTestVisibleInChrome="True">
						<Button x:Name="bmin" Style="{StaticResource CapBtn}" ToolTip="最小化" Content="─"/>
						<Button x:Name="bmax" Style="{StaticResource CapBtn}" ToolTip="最大化" Content="□"/>
						<Button x:Name="bclosewin" Style="{StaticResource CapBtnClose}" ToolTip="关闭" Content="✕"/>
					</StackPanel>
				</Grid>
			</Border>

			<!-- 第 2 行：Sumatra 风格工具栏（图标来自 Tabler / Sumatra SvgIcons 线框） -->
			<Border x:Name="ptoolbar" DockPanel.Dock="Top" Background="{DynamicResource BgToolbar}"
			        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="6,2" MinHeight="28">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<!-- 打开（folder） -->
					<Button x:Name="bopen" Style="{StaticResource ToolIconBtn}" ToolTip="打开 (Ctrl+O)">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M5,4 h4 l3,3 h7 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 h-14 a2,2 0 0 1 -2,-2 v-11 a2,2 0 0 1 2,-2"/>
					</Button>
					<!-- 打印（printer） -->
					<Button x:Name="bprint" Style="{StaticResource ToolIconBtn}" ToolTip="打印 (Ctrl+P)">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M17,17 h2 a2,2 0 0 0 2,-2 v-4 a2,2 0 0 0 -2,-2 h-14 a2,2 0 0 0 -2,2 v4 a2,2 0 0 0 2,2 h2 M17,9 v-4 a2,2 0 0 0 -2,-2 h-6 a2,2 0 0 0 -2,2 v4 M7,13 h10 a2,2 0 0 1 2,2 v4 a2,2 0 0 1 -2,2 h-10 a2,2 0 0 1 -2,-2 v-4 a2,2 0 0 1 2,-2"/>
					</Button>
					<!-- 目录侧栏（list / outline） -->
					<ToggleButton x:Name="bside" Style="{StaticResource ToolIconToggle}" ToolTip="目录 (F4)"
					              IsChecked="True" Margin="2,0,0,0">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M5,4 h14 a2,2 0 0 1 2,2 v12 a2,2 0 0 1 -2,2 h-14 a2,2 0 0 1 -2,-2 v-12 a2,2 0 0 1 2,-2 M9,4 v16 M12,8 h5 M12,12 h5 M12,16 h3"/>
					</ToggleButton>

					<!-- 页码: [n] / total -->
					<TextBlock x:Name="lbpagelabel" Text="页码:" VerticalAlignment="Center" Margin="8,0,4,0"
					           Foreground="{DynamicResource TextMuted}"/>
					<TextBox x:Name="epage" Width="48" Height="22"
					         VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
					         Padding="2,0,4,0" Margin="0,0,2,0"
					         ToolTip="页码 (Ctrl+G)"
					         BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
					         Background="White"/>
					<TextBlock x:Name="lbpagetotal" Text="/ 0" VerticalAlignment="Center" Margin="2,0,2,0"
					           Foreground="{DynamicResource TextMuted}" MinWidth="40"/>

					<!-- 上一页 / 下一页（arrow-left / arrow-right） -->
					<Button x:Name="bprev" Style="{StaticResource ToolIconBtn}" ToolTip="上一页 (PgUp)">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M5,12 L19,12 M5,12 L11,18 M5,12 L11,6"/>
					</Button>
					<Button x:Name="bnext" Style="{StaticResource ToolIconBtn}" ToolTip="下一页 (PgDn)">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M5,12 L19,12 M13,18 L19,12 M13,6 L19,12"/>
					</Button>

					<!-- 单页适页（square） -->
					<Button x:Name="bfitpage" Style="{StaticResource ToolIconBtn}" ToolTip="适合单页 (Ctrl+0)" Margin="6,0,0,0">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M4,4 h16 a2,2 0 0 1 2,2 v12 a2,2 0 0 1 -2,2 h-16 a2,2 0 0 1 -2,-2 v-12 a2,2 0 0 1 2,-2"/>
					</Button>
					<!-- 连续适宽（layout-rows） -->
					<Button x:Name="bfitwidth" Style="{StaticResource ToolIconBtn}" ToolTip="适合宽度并连续显示 (Ctrl+2)">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M3,3 h18 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 h-18 a2,2 0 0 1 -2,-2 v-14 a2,2 0 0 1 2,-2 M3,12 L21,12"/>
					</Button>
					<!-- 逆时针旋转 -->
					<Button x:Name="brotatel" Style="{StaticResource ToolIconBtn}" ToolTip="向左旋转 90° ([)">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M15,4.55 a8,8 0 0 0 -6,14.9 M9,14 v6 h-6"/>
					</Button>
					<!-- 顺时针旋转 -->
					<Button x:Name="brotater" Style="{StaticResource ToolIconBtn}" ToolTip="向右旋转 90° (])">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M9,4.55 a8,8 0 0 1 6,14.9 M15,14 v6 h6"/>
					</Button>
					<!-- 缩小（zoom-out） -->
					<Button x:Name="bzoomout" Style="{StaticResource ToolIconBtn}" ToolTip="缩小 (Ctrl+-)">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M10,10 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 M7,10 L13,10 M21,21 L15,15"/>
					</Button>
					<!-- 放大（zoom-in） -->
					<Button x:Name="bzoomin" Style="{StaticResource ToolIconBtn}" ToolTip="放大 (Ctrl++)">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M10,10 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 M7,10 L13,10 M10,7 L10,13 M21,21 L15,15"/>
					</Button>

					<!-- 查找 -->
					<TextBlock x:Name="lbfindlabel" Text="查找:" VerticalAlignment="Center" Margin="10,0,4,0"
					           Foreground="{DynamicResource TextMuted}"/>
					<TextBox x:Name="efind" Width="140" Height="22" VerticalContentAlignment="Center"
					         Margin="0,0,2,0" Padding="6,0"
					         ToolTip="查找 (Ctrl+F /)"
					         BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
					         Background="White"/>
					<!-- 上一个（chevron-left） -->
					<Button x:Name="bfindprev" Style="{StaticResource ToolIconBtn}" ToolTip="上一个">
						<Path Style="{StaticResource ToolIconPath}" Data="M15,6 L9,12 L15,18"/>
					</Button>
					<!-- 下一个（chevron-right） -->
					<Button x:Name="bfindnext" Style="{StaticResource ToolIconBtn}" ToolTip="下一个">
						<Path Style="{StaticResource ToolIconPath}" Data="M9,6 L15,12 L9,18"/>
					</Button>
					<TextBlock x:Name="lbfind" Text="" VerticalAlignment="Center"
					           Margin="2,0,4,0" MinWidth="28"
					           Foreground="{DynamicResource TextMuted}" FontSize="11"/>
					<!-- 区分大小写 Aa -->
					<ToggleButton x:Name="bcase" Style="{StaticResource CaseToggle}"
					              Width="28" Height="22" Margin="0,0,0,0"
					              Content="Aa" FontSize="11" FontWeight="SemiBold"
					              ToolTip="区分大小写"/>

					<!-- TXT / MD 编辑入口（Toggle：编辑中按下态） -->
					<ToggleButton x:Name="btxtedit" Style="{StaticResource ToolIconToggle}" Margin="8,0,0,0"
					              ToolTip="编辑文本" Visibility="Collapsed">
						<Path x:Name="icontxtedit" Style="{StaticResource ToolIconPath}"
						      Data="M4,20 L4,16 L16,4 a2,2 0 0 1 2.8,0 l1.2,1.2 a2,2 0 0 1 0,2.8 L8,20 L4,20 M13,7 L17,11"/>
					</ToggleButton>
					<Button x:Name="btxtsave" Style="{StaticResource ToolIconBtn}"
					        ToolTip="保存 (Ctrl+S)" Visibility="Collapsed">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M5,4 h11 l3,3 v12 a1,1 0 0 1 -1,1 h-13 a1,1 0 0 1 -1,-1 v-14 a1,1 0 0 1 1,-1 M8,4 v5 h8 v-5 M8,20 v-6 h8 v6"/>
					</Button>
					<!-- XLSX 编辑入口（Toggle：编辑中按下态） -->
					<ToggleButton x:Name="bxlsxedit" Style="{StaticResource ToolIconToggle}" Margin="8,0,0,0"
					              ToolTip="编辑表格" Visibility="Collapsed">
						<Path x:Name="iconxlsxedit" Style="{StaticResource ToolIconPath}"
						      Data="M4,20 L4,16 L16,4 a2,2 0 0 1 2.8,0 l1.2,1.2 a2,2 0 0 1 0,2.8 L8,20 L4,20 M13,7 L17,11"/>
					</ToggleButton>
					<Button x:Name="bxlsxsave" Style="{StaticResource ToolIconBtn}"
					        ToolTip="保存 (Ctrl+S)" Visibility="Collapsed">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M5,4 h11 l3,3 v12 a1,1 0 0 1 -1,1 h-13 a1,1 0 0 1 -1,-1 v-14 a1,1 0 0 1 1,-1 M8,4 v5 h8 v-5 M8,20 v-6 h8 v6"/>
					</Button>
					<!-- PDF 标注模式 -->
					<ToggleButton x:Name="bpannot" Style="{StaticResource ToolIconToggle}" Margin="8,0,0,0"
					              ToolTip="标注模式" Visibility="Collapsed">
						<!-- 荧光笔 / 标注 -->
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M4,17 L9,5 h2 L16,17 M7,12 h6 M15,18 l4,-4 l1.5,1.5 l-4,4 z"/>
					</ToggleButton>
					<!-- PDF 编辑 -->
					<Button x:Name="bpfdedit" Style="{StaticResource ToolIconBtn}" Margin="4,0,0,0"
					        ToolTip="编辑 PDF" Visibility="Collapsed">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M14,3 h4 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 h-12 a2,2 0 0 1 -2,-2 v-10 z M14,3 v4 h4 M8,13 h8 M8,17 h6"/>
					</Button>
					<Button x:Name="bpdfsave" Style="{StaticResource ToolIconBtn}"
					        ToolTip="保存 PDF (Ctrl+S)" Visibility="Collapsed">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M5,4 h11 l3,3 v12 a1,1 0 0 1 -1,1 h-13 a1,1 0 0 1 -1,-1 v-14 a1,1 0 0 1 1,-1 M8,4 v5 h8 v-5 M8,20 v-6 h8 v6"/>
					</Button>
				</StackPanel>
			</Border>

			<!-- 书签栏（Chrome 风格；Ctrl+Shift+B 切换；可拖入文件/文件夹） -->
			<Border x:Name="pbookmarks" DockPanel.Dock="Top" Background="{DynamicResource BgToolbar}"
			        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
			        Padding="4,1" MinHeight="28" Visibility="Collapsed"
			        AllowDrop="True" ToolTip="书签栏 · 拖入文件/文件夹可添加 · 右键新建分组 · Ctrl+D 添加 · Ctrl+Shift+B 显示/隐藏">
				<Grid AllowDrop="True">
					<!-- 拖入高亮底 -->
					<Border x:Name="pbookmarkdropglow" Background="#DBEAFE" BorderBrush="#2563EB"
					        BorderThickness="1.5" CornerRadius="4" Margin="0" Visibility="Collapsed"
					        IsHitTestVisible="False"/>
					<DockPanel>
						<Button x:Name="bbookmarkmore" DockPanel.Dock="Right" Content="⋯" Width="26" Height="22"
						        ToolTip="书签菜单" Padding="0" Margin="2,0,2,0" Cursor="Hand"
						        Background="Transparent" BorderThickness="0"
						        Foreground="{DynamicResource TextMuted}" FontSize="14"/>
						<ScrollViewer x:Name="svbookmarks" HorizontalScrollBarVisibility="Auto"
						              VerticalScrollBarVisibility="Disabled"
						              VerticalAlignment="Center" Background="Transparent" AllowDrop="True">
							<Grid x:Name="pbookmarklayer" MinHeight="24" AllowDrop="True">
								<TextBlock x:Name="lbbookmarkhint" Text="将文件或文件夹拖到此处添加书签"
								           FontSize="11" Foreground="#9CA3AF"
								           VerticalAlignment="Center" Margin="8,0,0,0"
								           IsHitTestVisible="False"/>
								<!-- 拖入文件时覆盖提示 -->
								<TextBlock x:Name="lbbookmarkdroplabel" Text="松开以添加书签"
								           FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"
								           VerticalAlignment="Center" HorizontalAlignment="Center"
								           Visibility="Collapsed" IsHitTestVisible="False"/>
								<StackPanel x:Name="pbookmarkitems" Orientation="Horizontal"
								            VerticalAlignment="Center" AllowDrop="True"/>
								<!-- 排序插入指示：覆盖层绝对定位，不挤动芯片 -->
								<Canvas x:Name="pbookmarkinsertlayer" IsHitTestVisible="False"
								        ClipToBounds="False"
								        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
								        Background="Transparent">
									<!-- 竖条 + 上下横帽，Chrome 式目标位置提示 -->
									<Border x:Name="bbookmarkinsert" Width="3" Height="22"
									        Background="#2563EB" CornerRadius="1.5"
									        Visibility="Collapsed" SnapsToDevicePixels="True">
										<Border.Effect>
											<DropShadowEffect BlurRadius="6" ShadowDepth="0"
											                  Color="#2563EB" Opacity="0.85"/>
										</Border.Effect>
									</Border>
								</Canvas>
							</Grid>
						</ScrollViewer>
					</DockPanel>
				</Grid>
			</Border>

			<!-- PDF 标注工具栏：仅标注模式显示 -->
			<Border x:Name="ppdfannot" DockPanel.Dock="Top" Background="{DynamicResource BgToolbar}"
			        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
			        Padding="6,2" MinHeight="28" Visibility="Collapsed">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<!-- 手型：平移 -->
					<ToggleButton x:Name="bannothand" Style="{StaticResource ToolIconToggle}" ToolTip="手型（平移）">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M8,11 v-4 a1.2,1.2 0 0 1 2.4,0 v4 M10.4,10.5 v-5.5 a1.2,1.2 0 0 1 2.4,0 v5.5 M12.8,10.8 v-4.2 a1.2,1.2 0 0 1 2.4,0 v6.5 c0,2.2 -1.5,4.2 -3.8,4.2 h-1.2 c-2.4,0 -4.2,-1.6 -4.8,-3.8 l-1.6,-5.2 a1.1,1.1 0 0 1 2.1,-0.7 l1.1,3.2"/>
					</ToggleButton>
					<!-- 框选：选择/移动/调整 -->
					<ToggleButton x:Name="bannotsel" Style="{StaticResource ToolIconToggle}" ToolTip="框选（选择/移动/调整）">
						<Path Style="{StaticResource ToolIconPath}" Data="M4,4 L4,16 L8,12 L11,18 L13,17 L10,11 L16,11 Z"/>
					</ToggleButton>
					<ToggleButton x:Name="bannotpen" Style="{StaticResource ToolIconToggle}" ToolTip="钢笔（可连续画）">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M4,20 L4,16 L14,6 a1.5,1.5 0 0 1 2,0 l2,2 a1.5,1.5 0 0 1 0,2 L8,20 Z M12,8 L16,12"/>
					</ToggleButton>
					<ToggleButton x:Name="bannothl" Style="{StaticResource ToolIconToggle}" ToolTip="荧光笔（可连续画）">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M4,16 L10,4 h3 L19,16 M7,12 h8 M5,18 h14" StrokeThickness="2"/>
					</ToggleButton>
					<!-- 橡皮 -->
					<ToggleButton x:Name="bannoteraser" Style="{StaticResource ToolIconToggle}" ToolTip="橡皮">
						<Path Style="{StaticResource ToolIconPath}"
						      Data="M4,16 L12,4 h4 L8,20 Z M8,20 h8 M6,14 L14,6"/>
					</ToggleButton>
